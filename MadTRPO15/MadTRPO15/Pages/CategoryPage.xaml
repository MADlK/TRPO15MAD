<Page x:Class="MadTRPO15.Pages.CategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MadTRPO15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource self}}"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      Title="Категории">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBox Text="{Binding searchQuery, UpdateSourceTrigger=PropertyChanged}"
             Grid.ColumnSpan="2"
             md:HintAssist.Hint="Введите название"
             TextChanged="TextBox_TextChanged"/>

        <StackPanel Grid.Row="1">
            <Button Click="Button_Click_1"
                Content="Добавить"
                Margin="10"/>
            <Button Click="Button_Click_2"
                Content="Изменить"
                Margin="10"/>
            <Button Click="Button_Click"
                Content="Удалить"
                Margin="10"/>
        </StackPanel>







        <!--лист-->
        <StackPanel Grid.Row="1" Grid.Column="1">
            <ListView Grid.Column="1"
       HorizontalContentAlignment="Stretch"
       Name="lb"
       SelectionChanged="ListView_SelectionChanged"
       SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"
       ItemsSource="{Binding Categories}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>

                            </Grid.RowDefinitions>

                            <TextBlock 
                        
                                Margin="0 15 0 0"
                                HorizontalAlignment="Left"
                                Grid.Row="2">
                 
                 <Run Text="{Binding Name}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <WrapPanel Margin="0 5 0 0">
                <TextBlock Text="{Binding Categories.Count, StringFormat='{}Всего записей:{0}'}"/>
                <TextBlock Text="{Binding Items.Count, ElementName=lb,StringFormat='{} Показано: {0}'}"/>
            </WrapPanel>
        </StackPanel>
       

        <StackPanel x:Name="AdminPanel"
                Grid.ColumnSpan="2"
                Grid.Row="3"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
            <Button Content="Бренды"
                Click="Button_Click_3"
                Margin="10"/>
            <Button Content="Техника"
                    Click="Button_Click_4"
                Margin="10"/>
            <Button Content="Тэги"
                    Click="Button_Click_5"
                Margin="10"/>

        </StackPanel>
    </Grid>
</Page>
