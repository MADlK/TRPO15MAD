<Application x:Class="MadTRPO15.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MadTRPO15"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                
                
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
                <md:CustomColorTheme BaseTheme="Light"
                          PrimaryColor="#00c4b4"
                         SecondaryColor="#00b4c4"/>




            </ResourceDictionary.MergedDictionaries>


            <Style TargetType="Grid" >
                <Setter Property="Background" Value="#dfeaeb"/>
                
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#00c4b4"/>
                <Setter Property="Margin" Value="10"/>
                
                <Setter Property="FontSize" Value="14"/>

            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Background" Value="#00c4b4"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="Background" Value="#00c4b4"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
                <Setter Property="Background" Value="#00c4b4"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                
            </Style>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#00b4c4"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="False">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignDatePicker}">
                <Setter Property="Background" Value="#00c4b4"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>


            <SolidColorBrush x:Key="MainBg" Color="#DFEAEB"/>
            <SolidColorBrush x:Key="Prim" Color="#00c4b4"/>
            <SolidColorBrush x:Key="Sec" Color="#00b4c4"/>
           
          
        </ResourceDictionary>
    </Application.Resources>
</Application>
