<Page x:Class="MadTRPO15.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MadTRPO15.Pages"
      mc:Ignorable="d" 
      xmlns:C="clr-namespace:MadTRPO15"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800" 
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="Техника" >
    <Page.Resources>
        <C:ConverterS x:Key="Conve"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBox Text="{Binding searchQuery, UpdateSourceTrigger=PropertyChanged}"
                 Grid.ColumnSpan="2"
                 md:HintAssist.Hint="Введите название"
                 TextChanged="TextBox_TextChanged_1"/>
        <!--сортировка i sortirovka-->
        <StackPanel Orientation="Vertical" Grid.Row="1" >
            <Label>Фильтрация</Label>
            <ComboBox SelectionChanged="ComboBox_SelectionChanged"
                      Name="CB">
                <ComboBox.Items>
                    <ComboBoxItem Tag="Category">По категории</ComboBoxItem>
                    <ComboBoxItem Tag="Brand">По бренду</ComboBoxItem>
                    <ComboBoxItem Tag="CostAsc">По цене возрастание</ComboBoxItem>
                    <ComboBoxItem Tag="CostDesc">По цене убывание</ComboBoxItem>
                    <ComboBoxItem Tag="StockDesc">Кол-во убывание</ComboBoxItem>
                    <ComboBoxItem Tag="StockAsc">Кол-во возрастание</ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>


            <Label Content="От"/>
            <TextBox Text="{Binding CostFrom, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TextBox_TextChanged"
                     md:HintAssist.Hint="Введите цену"
                     />
            <Label Content="До"/>
            <TextBox Text="{Binding CostTo, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TextBox_TextChanged"
                     md:HintAssist.Hint="Введите цену"/>



            <Button Click="Button_Click"
                    Content="Сбросить фильтры"
                    Margin="10"/>





            <StackPanel Name="AdminP">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="Добавить"
                            Click="Button_Click_4"
                            Margin="10"/>
                    <Button Content="Изменить"
                            Click="Button_Click_5"
                            Margin="10"/>
                </StackPanel>
                
                <Button Content="Удалить"
                        Click="Button_Click_6"
                        Margin="10"/>
            </StackPanel>
            
            
        </StackPanel>
        
      
      
        
        <!--лист-->
        <StackPanel Grid.Row="1" Grid.Column="1">
            <WrapPanel Margin="0 5 0 0">
                <TextBlock Text="{Binding Products.Count, StringFormat='{}Всего записей:{0}'}"/>
                <TextBlock Text="{Binding Items.Count, ElementName=lb,StringFormat='{} Показано: {0}'}"/>
            </WrapPanel>
            <ListView Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            
                      Name="lb"
            SelectedItem="{Binding SelectedProduct}"
            ItemsSource="{Binding Products}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <DockPanel 
                                  >

                                <TextBlock 
                                         HorizontalAlignment="Left"
                                         DockPanel.Dock="Left">
                                    <Run Text="Название "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>

                                <TextBlock 
                                         HorizontalAlignment="Right"
                                         DockPanel.Dock="Right">
                                     <Run Text="Цена "/>
                                    <Run Text="{Binding NamPricee}"/>
                                </TextBlock>


                            </DockPanel>



                            <TextBlock 
                                     HorizontalAlignment="Left"
                                     Grid.Row="1">
                                 <Run Text="Рейтинг "/>
                                    <Run Text="{Binding Rating}"/>
                            </TextBlock>




                            <TextBlock 
                                     Margin="0 10 0 0"
                                     HorizontalAlignment="Left"
                                     Grid.Row="2">
                                <Run Text="Категория "/>
                                <Run Text="{Binding Category.Name}"/>
                            </TextBlock>



                            <DockPanel Margin="0 10 0 0"
                                  Grid.Row="3">
                                <TextBlock 
                                     HorizontalAlignment="Left"
                                     DockPanel.Dock="Left">
                                    <Run Text="Описание "/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                                <TextBlock  
                                     DockPanel.Dock="Right"
                                     HorizontalAlignment="Right">
                                    <Run Text="Остаток "/>
                                    <Run Text="{Binding Stock}"
                                         Foreground="{Binding Stock, Converter={StaticResource Conve}}"/>
                                    
                                </TextBlock>
                            </DockPanel>





                            <ItemsControl ItemsSource="{Binding Tags}"
                                Grid.Row="4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Background="#00b4c4"
                                            Text="{Binding Name, StringFormat='#{0}'}"
                                         Margin="0 0 8 0"
                                         FontSize="13"
                                         />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <!--<TextBlock Text="{Binding Brand.Name}"
                             Margin="0 10 0 0"
                             HorizontalAlignment="Left"
                             Grid.Row="5"/>-->

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
        </StackPanel>
      

        <StackPanel x:Name="AdminPanel"
                    Grid.ColumnSpan="2"
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button Content="Бренды"
                    Click="Button_Click_1"
                    Margin="10"/>
            <Button Content="Категории"
                    Click="Button_Click_2"
                    Margin="10"/>
            <Button Content="Тэги"
                    Click="Button_Click_3"
                    Margin="10"/>
            
        </StackPanel>
    </Grid>
</Page>
